[Unit]
Description=AI Slop Detector web runner API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-slop-detector
Group=ai-slop-detector
WorkingDirectory=/opt/ai-slop-detector
Environment=WEB_RUNNER_ADDR=127.0.0.1:8081
EnvironmentFile=/etc/ai-slop-detector/web-runner.env
ExecStart=/opt/ai-slop-detector/current/web-runner --data-dir /var/lib/ai-slop-detector --workspace /var/lib/ai-slop-detector/workspaces --rubrics-dir /opt/ai-slop-detector/current/rubrics
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-slop-detector

[Install]
WantedBy=multi-user.target
