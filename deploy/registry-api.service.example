[Unit]
Description=AI Slop Detector team registry API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-slop-detector
Group=ai-slop-detector
WorkingDirectory=/var/lib/ai-slop-detector
EnvironmentFile=/etc/ai-slop-detector/registry-bridge.env
ExecStart=/opt/ai-slop-detector/registry-api --registry /var/lib/ai-slop-detector/registry.yaml --listen 172.17.0.1:8082 --public-bundle /var/lib/ai-slop-detector/public --auto-evaluate --runner-url http://127.0.0.1:8081 --daily-limit 10
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-slop-detector

[Install]
WantedBy=multi-user.target
