{
  "$meta": {
    "project": "Автооценка качества кода — интерфейс жюри",
    "stack": "React + TypeScript + Tailwind 4 + shadcn/ui (radix-nova) + Recharts + Shiki",
    "fonts": { "sans": "Geist", "mono": "Geist Mono", "hosting": "локально, без обращения к сети" },
    "note": "Значения ниже — источник правды. В разметке не должно остаться ни одного литерального цвета: всё через CSS-переменные на :root и .dark."
  },

  "color": {
    "bg":            { "light": "#FBFBFC", "dark": "#08090A", "use": "фон страницы" },
    "surface":       { "light": "#FFFFFF", "dark": "#161719", "use": "карточки, таблицы, поповеры" },
    "muted":         { "light": "#F3F4F7", "dark": "#1D1E21", "use": "шапки таблиц, вторичные панели" },
    "surface-hot":   { "light": "#EEF0FF", "dark": "#252C36", "use": "акцентированные компактные показатели" },
    "surface-focus": { "light": "#F5F5FF", "dark": "#10222C", "use": "панель выбранной команды" },
    "focus-border":  { "light": "#C6C7F2", "dark": "#285064", "use": "граница панели выбранной команды" },
    "muted-open":    { "light": "#FAFAFD", "dark": "#25262A", "use": "подложка раскрытого узла дерева" },
    "code":          { "light": "#F7F8FA", "dark": "#111419", "use": "подложка фрагмента кода" },
    "border":        { "light": "#E4E6EB", "dark": "#27282D", "use": "разделители, рамки карточек" },
    "border-strong": { "light": "#C9CED8", "dark": "#3A3B42", "use": "рамки полей и кнопок" },
    "fg":            { "light": "#14161A", "dark": "#F3F3F3", "use": "основной текст, числа баллов" },
    "fg-muted":      { "light": "#565C6B", "dark": "#9A9CA2", "use": "пояснения, подписи осей" },
    "fg-subtle":     { "light": "#656D7C", "dark": "#74767D", "use": "вторичный текст, метаданные, единицы и пути; контраст AA на всех стандартных поверхностях" },
    "fg-faint":      { "light": "#B4BAC6", "dark": "#5E6067", "use": "номера строк кода, отключённые линии" },
    "primary":       { "light": "#5B5BD6", "dark": "#55C2FF", "use": "фокус, вес узла, акценты" },
    "primaryGlow":   { "light": "rgba(91,91,214,0.18)", "dark": "rgba(85,194,255,0.20)", "use": "мягкая глубина вокруг главного показателя" },
    "primary-soft":  { "light": "#EEEEFB", "dark": "#132D3A", "use": "подложка активного состояния и иконок" },
    "link":          { "light": "#4A4AC4", "dark": "#8BD8FF", "use": "ссылки" },
    "link-hover":    { "light": "#3A3AA8", "dark": "#B5E7FF", "use": "ссылки при наведении" },
    "on-accent":     { "light": "#FEFEFE", "dark": "#071017", "use": "текст на цветной заливке" },
    "track":         { "light": "#E9EBEF", "dark": "#25262A", "use": "дорожка под баллом" },
    "selection":     { "light": "#DFE0FF", "dark": "#204B62", "use": "выделение текста" },
    "track-partial": { "light": "repeating-linear-gradient(135deg,#E9EBEF,#E9EBEF 4px,#DDE0E6 4px,#DDE0E6 8px)", "dark": "repeating-linear-gradient(135deg,#25262A,#25262A 4px,#2D2E33 4px,#2D2E33 8px)", "use": "дорожка частичной оценки" }
  },

  "scoreScale": {
    "$rule": "Один тон, пять ступеней по светлоте. Красного и зелёного в шкале нет: низкий балл — не ошибка, а положение на шкале. В тёмной теме шкала разворачивается — светлее всегда значит выше.",
    "$redundancy": "Цвет никогда не единственный носитель: рядом обязательны число, длина дорожки и слово.",
    "levels": [
      { "level": 1, "range": [0, 2.9],  "word": "низкий",         "light": "#708598", "dark": "#687885", "contrastLight": 3.82, "contrastDark": 3.89, "grayscale": "#81" },
      { "level": 2, "range": [3, 4.9],  "word": "ниже среднего",  "light": "#52738B", "dark": "#7F9AAD", "contrastLight": 5.02, "contrastDark": 6.01, "grayscale": "#6F" },
      { "level": 3, "range": [5, 6.9],  "word": "средний",        "light": "#38637C", "dark": "#9DBBCC", "contrastLight": 6.47, "contrastDark": 8.81, "grayscale": "#5E" },
      { "level": 4, "range": [7, 8.4],  "word": "выше среднего",  "light": "#215269", "dark": "#BCD9E6", "contrastLight": 8.48, "contrastDark": 12.02, "grayscale": "#4E" },
      { "level": 5, "range": [8.5, 10], "word": "высокий",        "light": "#0E4255", "dark": "#E2F3F9", "contrastLight": 10.89, "contrastDark": 15.58, "grayscale": "#3F" }
    ],
    "noData": { "render": "прочерк «—» и пустая дорожка с пунктирной рамкой border-strong", "rule": "никогда не рисовать нулём" }
  },

  "severity": {
    "$rule": "Единственное место, где цвет несёт тревогу. У каждого значения своя форма иконки — цвет продублирован.",
    "critical":  { "icon": "octagon-alert",  "bg": { "light": "#FCE9E7", "dark": "#2C1A19" }, "fg": { "light": "#9F1F1A", "dark": "#F3908A" }, "border": { "light": "#F3C9C5", "dark": "#4A2624" }, "chart": { "light": "#9F1F1A", "dark": "#F3908A" } },
    "major":     { "icon": "triangle-alert", "bg": { "light": "#FDF1E3", "dark": "#2D2318" }, "fg": { "light": "#8A4B0A", "dark": "#EBA35F" }, "border": { "light": "#F2DBBB", "dark": "#4A3720" }, "chart": { "light": "#C46A12", "dark": "#E09A54" } },
    "minor":     { "icon": "circle-dot",     "bg": { "light": "#F2F1E5", "dark": "#23241A" }, "fg": { "light": "#63591A", "dark": "#CFC47E" }, "border": { "light": "#E2DFC7", "dark": "#3A3A26" }, "chart": { "light": "#8A7A2A", "dark": "#C2B36A" } },
    "info":      { "icon": "info",           "bg": { "light": "#EEF0F4", "dark": "#1B2028" }, "fg": { "light": "#4A5261", "dark": "#9AA4B4" }, "border": { "light": "#DCE0E7", "dark": "#2E353F" }, "chart": { "light": "#6B7482", "dark": "#98A1AF" } },
    "strength":  { "icon": "check",          "bg": { "light": "#E8F3EC", "dark": "#16241C" }, "fg": { "light": "#245C3A", "dark": "#74C295" }, "border": { "light": "#C8E1D2", "dark": "#27412F" } }
  },

  "status": {
    "ok":      { "label": "Оценено",    "icon": "check",      "style": "strength" },
    "partial": { "label": "Частично",   "icon": "circle-half","style": "info" },
    "none":    { "label": "Нет данных", "icon": "minus",      "style": "muted", "border": "dashed" },
    "failed":  { "label": "Не удалось", "icon": "x-circle",   "style": "critical" }
  },

  "warning": {
    "$rule": "Песочный, а не красный: предупреждение оценки — информация для жюри, а не ошибка.",
    "bg": { "light": "#FBF5E8", "dark": "#221E14" },
    "fg": { "light": "#8A4B0A", "dark": "#EBA35F" },
    "fgBody": { "light": "#6B3C09", "dark": "#D9A56E" },
    "border": { "light": "#EDDFBE", "dark": "#3B331F" },
    "kinds": { "promptInjection": "shield-alert", "sizeLimit": "triangle-alert" }
  },

  "confidence": {
    "$rule": "Цветом не кодируется вовсе. Различают: число заполненных точек из трёх, слово и тип рамки.",
    "high":   { "dots": 3, "border": "solid",  "bg": "surface" },
    "medium": { "dots": 2, "border": "solid",  "bg": "surface" },
    "low":    { "dots": 1, "border": "dashed", "bg": "muted" }
  },

  "chart": {
    "teamSeries":   { "stroke": { "light": "#215269", "dark": "#BCD9E6" }, "fill": { "light": "rgba(33,82,105,0.14)", "dark": "rgba(188,217,230,0.16)" }, "strokeWidth": 2.2 },
    "medianSeries": { "stroke": { "light": "#B08B4F", "dark": "#D8B579" }, "strokeWidth": 1.8, "dash": "5 4" },
    "averageBar":   { "fill": { "light": "#C9CED8", "dark": "#39404A" } },
    "grid":         { "light": "#E4E6EB", "dark": "#272C34" },
    "gridOuter":    { "light": "#C9CED8", "dark": "#39404A" },
    "radar": { "axes": 8, "radius": 130, "rings": [26, 52, 78, 104, 130], "labelRadius": 158, "labelCarriesValues": true },
    "minTeamsForComparison": 5
  },

  "codeHighlight": {
    "$note": "Shiki на этапе сборки, результат кладётся в JSON. В рантайме ни Shiki, ни сети.",
    "light": { "plain": "#24292F", "keyword": "#8250DF", "string": "#0A3069", "type": "#0550AE", "decorator": "#953800", "lineNumber": "#B4BAC6" },
    "dark":  { "plain": "#C9D1D9", "keyword": "#D2A8FF", "string": "#A5D6FF", "type": "#79C0FF", "decorator": "#FFA657", "lineNumber": "#6E7681" },
    "highlightedLine": { "bg": "severity.major.bg", "borderLeft": "3px solid severity.major.chart" }
  },

  "typography": {
    "score-hero":   { "size": 44,   "weight": 300, "tracking": "-0.02em", "use": "итоговый балл команды" },
    "score-large":  { "size": 32,   "weight": 300, "tracking": "-0.02em", "use": "балл области" },
    "score-metric": { "size": 26,   "weight": 300, "tracking": "-0.02em", "use": "балл метрики" },
    "h1":           { "size": 26,   "weight": 500, "tracking": "-0.02em", "use": "название команды" },
    "h2":           { "size": 22,   "weight": 500, "tracking": "-0.02em", "use": "заголовок экрана" },
    "count":        { "size": 20,   "weight": 300, "use": "счётчики находок" },
    "lead":         { "size": 15,   "weight": 400, "lineHeight": 1.55, "use": "краткий вывод метрики" },
    "strong":       { "size": 14,   "weight": 500, "use": "названия категорий, строки таблиц" },
    "body":         { "size": 13,   "weight": 400, "use": "базовый текст интерфейса" },
    "prose":        { "size": 12.5, "weight": 400, "lineHeight": 1.7, "use": "обоснование, длинный текст" },
    "meta":         { "size": 11.5, "weight": 500, "use": "бейджи, подписи, метаданные" },
    "overline":     { "size": 11,   "weight": 500, "tracking": "0.05em", "transform": "uppercase", "use": "заголовки колонок, надзаголовки" },
    "$numbers": "font-variant-numeric: tabular-nums на всех числах без исключения"
  },

  "space": { "scale": [4, 6, 8, 10, 12, 14, 16, 18, 20, 28, 40], "pagePadding": { "top": 28, "sides": 40 }, "cardPadding": [16, 18], "cellPadding": [9, 12] },
  "radius": { "badge": 6, "control": 8, "panel": 10, "card": 12 },
  "size": {
    "controlDesktop": 36,
    "controlMobile": 44,
    "controlCompact": 30,
    "badge": 22,
    "tableRow": 46,
    "gauge": { "hero": 10, "row": 8, "inline": 6, "micro": 4 },
    "minViewport": 360
  },

  "focus": { "ring": "2px solid var(--primary)", "offset": 2, "$rule": "outline: none не допускается нигде; у контейнеров с overflow: hidden оставлен внутренний отступ 2 px" },
  "motion": { "durationMs": 150, "cases": ["раскрытие узла", "появление подсказки"], "$rule": "полностью отключается при prefers-reduced-motion" }
}
