{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-slop-detector.local/schemas/evaluation-report.schema.json",
  "title": "Evaluation report",
  "description": "Результат оценки одной области команды на одном полном коммите.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "metrics", "overall_comment", "warnings"],
  "properties": {
    "meta": { "$ref": "#/$defs/reportMeta" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/metricScore" }
    },
    "overall_comment": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "suspected_prompt_injection",
          "repo_too_large",
          "file_limit_exceeded",
          "secret_redacted",
          "incomplete_area",
          "provider_error"
        ]
      }
    }
  },
  "$defs": {
    "reportMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "team_id",
        "area",
        "repo",
        "commit_sha",
        "skill_version",
        "rubric_version",
        "model",
        "evaluated_at"
      ],
      "properties": {
        "schema_version": { "const": "evaluation.v1" },
        "team_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "area": { "type": "string", "enum": ["backend", "frontend"] },
        "repo": { "type": "string", "minLength": 1, "maxLength": 500 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "rubric_version": { "type": "string", "enum": ["backend.v1", "frontend.v1"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evaluated_at": { "type": "string", "format": "date-time" }
      }
    },
    "metricScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "score", "max", "confidence", "summary", "rationale", "findings"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "max": { "const": 10 },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "severity", "file", "line_start", "line_end", "title", "explanation"],
      "properties": {
        "kind": { "type": "string", "enum": ["strength", "issue"] },
        "severity": { "type": "string", "enum": ["info", "minor", "major", "critical"] },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "suggestion": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "issue" } } },
          "then": { "required": ["suggestion"] }
        }
      ]
    }
  }
}
