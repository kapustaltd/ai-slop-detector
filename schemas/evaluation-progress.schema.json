{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-slop-detector.local/schemas/evaluation-progress.schema.json",
  "title": "EvaluationProgress",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "stage", "areas", "events"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "failed", "no_data", "running"]
    },
    "stage": {
      "type": "string",
      "enum": [
        "waiting",
        "dispatching",
        "runner_queued",
        "analyzing",
        "publishing",
        "done"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/area_progress"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "area_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "status",
        "included_files",
        "excluded_files",
        "completed_categories",
        "total_categories"
      ],
      "properties": {
        "area": {
          "type": "string",
          "enum": ["backend", "frontend"]
        },
        "status": {
          "type": "string",
          "enum": ["queued", "running", "done", "failed", "no_data"]
        },
        "included_files": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_files": {
          "type": "integer",
          "minimum": 0
        },
        "completed_categories": {
          "type": "integer",
          "minimum": 0
        },
        "total_categories": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "kind", "title"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "enum": [
            "stage",
            "scan",
            "area",
            "finding",
            "report",
            "error",
            "tool",
            "reasoning",
            "response",
            "context"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        },
        "area": {
          "type": "string",
          "enum": ["backend", "frontend"]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "category_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["running", "done", "failed"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line_start", "line_end"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "permalink": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
